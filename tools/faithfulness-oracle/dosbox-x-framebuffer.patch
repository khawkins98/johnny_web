 static rawscreenshot rawshot; // raw image data, translated palette
 
+/* --- BEGIN framebuffer oracle (rendering faithfulness) ---
+ * Dumps the EMULATED VGA framebuffer as a scene-labeled PPM by reusing the
+ * built-in raw-screenshot capture (VGA_DrawRawLine reads VGA memory directly +
+ * SetRawImagePalette() copies the DAC), so it is independent of the SDL/GFX
+ * output pipeline and works headless under SDL_VIDEODRIVER=dummy.
+ * Controlled by env: DBX_FB_DIR (output dir; enables the feature),
+ * DBX_FB_EVERY (auto-arm every N frames; 0 = only on explicit request),
+ * DBX_FB_MAX (cap total dumps), DBX_FB_START (skip first N frames).
+ * core_normal.cpp sets dbx_fb_want / dbx_fb_label from the ADS scene trace so
+ * a dump can be tagged with the currently-active ADS scene. See
+ * tools/faithfulness-oracle/RENDERING-ORACLE.md. */
+#include <cstdlib>
+#include <cstdio>
+#include <cstring>
+volatile int  dbx_fb_want = 0;           /* set by ADS hook: countdown of frames to capture */
+char          dbx_fb_label[64] = "frame"; /* scene tag for the filename */
+static unsigned long dbx_fb_frame_ctr = 0;
+static unsigned long dbx_fb_shot_ctr = 0;
+static void dbx_write_ppm(void) {
+	const char *dir = getenv("DBX_FB_DIR");
+	if (dir == NULL || *dir == 0) return;
+	if (rawshot.image == NULL || rawshot.image_palette == NULL) return;
+	if (rawshot.image_bpp != 8) return; /* Johnny runs Win3.1 SVGA 256-color = 8bpp */
+	const unsigned int w = rawshot.image_width, h = rawshot.image_height;
+	if (w == 0 || h == 0) return;
+	char path[1024];
+	/* sanitize label to keep filenames safe */
+	char lab[64]; unsigned li = 0;
+	for (const char *p = dbx_fb_label; *p && li < sizeof(lab)-1; p++)
+		lab[li++] = (*p=='/'||*p==' '||*p==':') ? '_' : *p;
+	lab[li] = 0;
+	snprintf(path, sizeof(path), "%s/fb_%06lu_%s.ppm", dir, dbx_fb_shot_ctr, lab);
+	FILE *fp = fopen(path, "wb");
+	if (fp == NULL) return;
+	fprintf(fp, "P6\n%u %u\n255\n", w, h);
+	const unsigned char *pal = rawshot.image_palette;
+	for (unsigned int y = 0; y < h; y++) {
+		const unsigned char *row = rawshot.image + (size_t)y * rawshot.image_stride;
+		for (unsigned int x = 0; x < w; x++) {
+			unsigned int idx = row[x];
+			unsigned char rgb[3] = { pal[idx*3+0], pal[idx*3+1], pal[idx*3+2] };
+			fwrite(rgb, 1, 3, fp);
+		}
+	}
+	fclose(fp);
+	dbx_fb_shot_ctr++;
+}
+/* --- END framebuffer oracle --- */
