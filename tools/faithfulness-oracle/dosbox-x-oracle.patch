+			/* indexed by (adsId - 0x65); name table 1068:166e */
+			static const char *DBX_ADS_NAMES[11] = {
+				"ACTIVITY","BUILDING","ADS67","FISHING","JOHNNY","MARY","MISCGAG",
+				"STAND","SUZY","VISITOR","WALKSTUF" };
+			extern volatile int dbx_fb_want;   /* frame countdown, defined in vga_draw.cpp */
+			extern char dbx_fb_label[64];
+			static bool dbx_ads_reported = false;
+			static unsigned int dbx_ads_target = 0x100; /* >0xff = disabled; set from env once */
+			static int dbx_ads_burst = 40; /* frames to capture per target load */
+			static bool dbx_ads_target_init = false;
+			/* director force-injection (option A): pin the scene-director queue
+			 * (DAT_1068_30f4[]) to ONE catalogue record so exactly one chosen
+			 * (adsId,tag) gag runs & loops -- bypasses story/spot/tide select.
+			 * Env: DBX_FORCE_ADS (hex), DBX_FORCE_TAG. See capture-original-gag.mjs. */
+			static bool dbx_force_on = false;
+			static unsigned int dbx_force_ads = 0, dbx_force_tag = 0;
+			static uint16_t dbx_force_recoff = 0; /* cached near-off of target rec (0=unfound) */
+			static bool dbx_force_armed = false;  /* one-time active-bit bootstrap */
+			if (!dbx_ads_target_init) {
+				dbx_ads_target_init = true;
+				const char *t = getenv("DBX_FB_ADS");
+				if (t && *t) dbx_ads_target = (unsigned int)strtoul(t, NULL, 0);
+				const char *b = getenv("DBX_FB_BURST");
+				if (b && *b) dbx_ads_burst = (int)strtoul(b, NULL, 10);
+				const char *fa = getenv("DBX_FORCE_ADS");
+				const char *ft = getenv("DBX_FORCE_TAG");
+				if (fa && *fa && ft && *ft) {
