+/* oracle trace helper: resolve an arbitrary guest selector to its linear base.
+ * In protected mode this walks the GDT/LDT (GetDescriptor routes to the LDT
+ * when selector&4); in real/vm86 it is the paragraph<<4. Used by the per-tick
+ * thread-list walk because the ADS context + thread nodes live in the context's
+ * own segment (DGROUP-stored far ptr), not in DS. */
+static inline PhysPt dbx_sel_base(uint16_t sel) {
+	if (cpu.pmode && !(reg_flags & FLAG_VM)) {
+		Descriptor d;
+		if (cpu.gdt.GetDescriptor(sel, d)) return (PhysPt)d.GetBase();
+		return 0;
+	}
+	return (PhysPt)sel << 4;
+}
