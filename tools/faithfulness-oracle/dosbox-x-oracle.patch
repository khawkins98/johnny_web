+						/* fi==0 is the scene director (FUN_1018_06bf). If force-injection is
+						 * enabled, pin its queue DAT_1068_30f4[] = { targetRecord, 0 } with
+						 * index DAT_1068_30f2 = 0 so it loads+runs+loops exactly one (adsId,tag).
+						 * startSpot(+3)->0 makes the walk-continuity gate FUN_1018_0b64 pass; the
+						 * active bit (+0xd &0x8000) is set once to bootstrap (the director re-sets
+						 * it on each gag completion, so the pinned record re-loads and loops). */
+						if (fi == 0 && dbx_force_on) {
+							const PhysPt dsb = SegPhys(ds);
+							if (dbx_force_recoff == 0) {
+								for (int ri = 0; ri < 79; ri++) {
+									uint16_t roff = (uint16_t)(0x1756 + ri * 0x11);
+									uint8_t aid = mem_readb(dsb + (PhysPt)(uint16_t)(roff + 0x0f));
+									uint8_t atg = mem_readb(dsb + (PhysPt)(uint16_t)(roff + 0x10));
+									if (aid == dbx_force_ads && atg == dbx_force_tag) { dbx_force_recoff = roff; break; }
+								}
+							}
+							if (dbx_force_recoff != 0) {
+								uint16_t roff = dbx_force_recoff;
+								mem_writew(dsb + 0x30f4u, roff);      /* queue[0] = target record */
+								mem_writew(dsb + 0x30f6u, 0);         /* queue[1] = terminator    */
+								mem_writew(dsb + 0x30f2u, 0);         /* queue index = 0          */
+								mem_writeb(dsb + (PhysPt)(uint16_t)(roff + 0x03), 0); /* startSpot=0 */
+								if (!dbx_force_armed) {
+									dbx_force_armed = true;
+									uint16_t fl = mem_readw(dsb + (PhysPt)(uint16_t)(roff + 0x0d));
+									mem_writew(dsb + (PhysPt)(uint16_t)(roff + 0x0d), (uint16_t)(fl | 0x8000));
+									if (dbx_fp) { fprintf(dbx_fp, "#FORCE ads=%02X tag=%u recoff=%04X\n", dbx_force_ads, dbx_force_tag, (unsigned)roff); fflush(dbx_fp); }
+								}
+							}
+						}
+						if (fi == 3 && dbx_thr_fp) {
+							const PhysPt dsb = SegPhys(ds);
+							int16_t idx = (int16_t)mem_readw(dsb + 0x2608u); /* DAT_1068_2608 */
+							fprintf(dbx_thr_fp, "THREADS %llu", dbx_tick_no);
+							if (idx >= 0) {
+								/* ADSctx far ptr = DS:*(idx*4+0x460e){off}, *(idx*4+0x4610){seg}.
+								 * The context HEADER lives in its own segment (ctxseg); the
+								 * head near-pointer it stores at ctx+0x10, and every thread
+								 * node it chains to (+0x3b), are DGROUP/DS-relative (the node
+								 * pool is a DGROUP allocation). So: read head from ctxseg,
+								 * walk nodes in DS. Node fields: slot@+0, tag@+2,
+								 * runstate@+0x2f, next@+0x3b. */
+								uint16_t ctxoff = mem_readw(dsb + (uint16_t)(idx * 4 + 0x460e));
+								uint16_t ctxseg = mem_readw(dsb + (uint16_t)(idx * 4 + 0x4610));
+								const PhysPt csb = dbx_sel_base(ctxseg);
+								uint16_t node   = mem_readw(csb + (uint16_t)(ctxoff + 0x10));
+								int guard = 0;
+								while (node != 0 && guard++ < 512) {
+									uint16_t slot = mem_readw(dsb + (uint16_t)(node + 0x00));
+									uint16_t tag  = mem_readw(dsb + (uint16_t)(node + 0x02));
+									uint16_t rs   = mem_readw(dsb + (uint16_t)(node + 0x2f));
+									fprintf(dbx_thr_fp, " %u:%u:%u",
+										(unsigned)slot, (unsigned)tag, (unsigned)rs);
+									node = mem_readw(dsb + (uint16_t)(node + 0x3b));
+								}
+							}
+							fprintf(dbx_thr_fp, "\n");
+							fflush(dbx_thr_fp);
+							dbx_tick_no++;
+						}
+						if (fi == 3 && dbx_delay_fp) {
+							static unsigned long long dbx_delay_tick = 0;
+							const PhysPt dsb = SegPhys(ds);
+							int16_t idx = (int16_t)mem_readw(dsb + 0x2608u); /* DAT_1068_2608 */
+							uint16_t nowLo = mem_readw(dsb + 0x2e72u); /* DAT_1068_2e72 */
+							uint16_t nowHi = mem_readw(dsb + 0x2e74u); /* DAT_1068_2e74 */
+							fprintf(dbx_delay_fp, "DELAY %llu now=%u:%u |", dbx_delay_tick, (unsigned)nowLo, (unsigned)nowHi);
+							if (idx >= 0) {
+								uint16_t ctxoff = mem_readw(dsb + (uint16_t)(idx * 4 + 0x460e));
+								uint16_t ctxseg = mem_readw(dsb + (uint16_t)(idx * 4 + 0x4610));
+								const PhysPt csb = dbx_sel_base(ctxseg);
+								uint16_t node   = mem_readw(csb + (uint16_t)(ctxoff + 0x10));
+								int guard = 0;
+								while (node != 0 && guard++ < 512) {
+									uint16_t slot  = mem_readw(dsb + (uint16_t)(node + 0x00));
+									uint16_t tag   = mem_readw(dsb + (uint16_t)(node + 0x02));
+									uint16_t rs    = mem_readw(dsb + (uint16_t)(node + 0x2f));
+									uint16_t delay = mem_readw(dsb + (uint16_t)(node + 0x29));
+									uint16_t dlLo  = mem_readw(dsb + (uint16_t)(node + 0x37));
+									uint16_t dlHi  = mem_readw(dsb + (uint16_t)(node + 0x39));
+									fprintf(dbx_delay_fp, " %u:%u:%u:%u:%u:%u",
+										(unsigned)slot, (unsigned)tag, (unsigned)rs,
+										(unsigned)delay, (unsigned)dlLo, (unsigned)dlHi);
+									node = mem_readw(dsb + (uint16_t)(node + 0x3b));
+								}
+							}
+							fprintf(dbx_delay_fp, "\n");
+							fflush(dbx_delay_fp);
+							dbx_delay_tick++;
+						}
+						break;
+					}
+					/* ADS-loader detection (framebuffer oracle scene tagging) */
+					{
+						bool amatch = true;
+						for (int k = 2; k < 24; k++) {
+							if (mem_readb(lin + (PhysPt)k) != DBX_ADS_SIG[k]) { amatch = false; break; }
+						}
+						if (amatch) {
+							const PhysPt ssb = SegPhys(ss);
+							uint16_t adsid = mem_readw(ssb + (uint16_t)(reg_sp + 4)); /* arg0 */
+							if (!dbx_ads_reported) {
+								dbx_ads_reported = true;
+								fprintf(dbx_fp, "#RESOLVE ads-loader seg=4 in_off=0C88 runtime_lin=%08lX\n",
+									(unsigned long)(lin));
+							}
+							fprintf(dbx_fp, "%llu ads-loader id=%04X\n", dbx_icount, (unsigned)adsid);
+							fflush(dbx_fp);
+							/* Tag + arm a framebuffer dump for the target ADS id. */
+							if (dbx_ads_target <= 0xff && (unsigned int)(adsid & 0xff) == dbx_ads_target) {
+								unsigned int id = adsid & 0xff;
+								const char *nm = (id >= 0x65 && id <= 0x6f) ? DBX_ADS_NAMES[id - 0x65] : "ADS";
+								snprintf(dbx_fb_label, sizeof(dbx_fb_label), "%s_id%02X", nm, id);
+								dbx_fb_want = dbx_ads_burst;
+							}
+						}
+					}
+				}
+			}
+		}
+		/* --- END oracle trace --- */
 #if C_DEBUG
 #if C_HEAVY_DEBUG
 		if (DEBUG_HeavyIsBreakpoint()) {
diff --git a/src/hardware/vga_draw.cpp b/src/hardware/vga_draw.cpp
index b8335f6..e24e72d 100644
--- a/src/hardware/vga_draw.cpp
+++ b/src/hardware/vga_draw.cpp
@@ -195,6 +195,55 @@ void rawscreenshot::allocpalette2(unsigned int count) {
 
 static rawscreenshot rawshot; // raw image data, translated palette
 
+/* --- BEGIN framebuffer oracle (rendering faithfulness) ---
+ * Dumps the EMULATED VGA framebuffer as a scene-labeled PPM by reusing the
+ * built-in raw-screenshot capture (VGA_DrawRawLine reads VGA memory directly +
+ * SetRawImagePalette() copies the DAC), so it is independent of the SDL/GFX
